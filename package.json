{
  "name": "soro-pon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "skin:validate": "vitest run src/ui/skins/skinValidate.test.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:crossbrowser": "playwright test --config=playwright.crossbrowser.config.ts",
    "test:visual:crossbrowser:update": "playwright test --config=playwright.crossbrowser.config.ts --update-snapshots",
    "qa:batch12:local-deploy": "node scripts/qa/run-batch12-local-deploy-rollback.mjs",
    "asset:image:prepare": "tools/asset-factory/soro-pon-ui/scripts/asset-image-prepare.sh",
    "asset:image:test": "tools/asset-factory/soro-pon-ui/scripts/run-python-tests.sh",
    "asset:image:generate": "tools/asset-factory/soro-pon-ui/scripts/codex-generate-raw.sh"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.10"
  }
}
