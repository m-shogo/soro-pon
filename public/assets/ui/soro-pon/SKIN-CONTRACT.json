  "limits": {
    "maxAssetFileBytes": 2097152,
    "maxSkinTotalBytes": 16777216,
    "maxIntrinsicSizePx": 2048,
    "maxNineSlicePx": 256,
    "maxTokensFileBytes": 32768,
    "maxManifestBytes": 65536
  },
